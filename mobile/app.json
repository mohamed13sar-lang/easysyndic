{
  "expo": {
    "name": "EasySyndic",
    "slug": "easy-syndic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LOGO (2).png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/LOGO (2).png"
    },
    "android": {
      "package": "com.easysyndic.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/LOGO (2).png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/LOGO (2).png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/LOGO (7).png",
          "imageWidth": 220,
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/LOGO (7).png",
            "imageWidth": 220
          },
          "ios": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/LOGO (7).png",
            "imageWidth": 220
          }
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-image",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2620f6f4-1a5f-4717-bee7-94af281cb41a"
      }
    },
    "owner": "medsar21"
  }
}
